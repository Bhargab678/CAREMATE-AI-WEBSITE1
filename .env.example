# CareMate AI — environment variables
#
# This is a static marketing site. There are NO required environment variables;
# it builds and runs with none set. The single OPTIONAL variable below only
# affects absolute URLs (canonical tags, sitemap, Open Graph / Twitter cards).
#
# To use it: copy this file to `.env.local` (for local dev) or set it in your
# host's dashboard (Vercel/Netlify/etc.), then rebuild.

# Public base URL of the deployed site (no trailing slash).
# Falls back to https://caremate-ai.com when unset.
NEXT_PUBLIC_SITE_URL=https://caremate-ai.com
